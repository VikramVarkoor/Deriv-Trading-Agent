# ─── Copy this file to .env.local and fill in your values ────────────────────
# Never commit .env.local to git!

# ── Groq (free AI inference) ──────────────────────────────────────────────────
# Sign up FREE at: https://console.groq.com → API Keys → Create API Key
# Free tier: 6,000 req/day, 500k tokens/min — well above what this agent needs
# Model: llama-3.3-70b-versatile
GROQ_API_KEY=gsk_...

# ── Twelve Data (forex OHLCV) ─────────────────────────────────────────────────
# Free tier at: https://twelvedata.com/pricing
# Free = 800 requests/day, more than enough for 5-min polling
TWELVE_DATA_API_KEY=your_twelve_data_key

# ── Supabase ──────────────────────────────────────────────────────────────────
# From: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...        # read-only, safe to expose
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # write access, NEVER expose to browser

# ── Deriv Demo API ────────────────────────────────────────────────────────────
# 1. Sign up FREE at: https://app.deriv.com (choose Demo account)
# 2. Go to: https://app.deriv.com/account/api-token
# 3. Create a token with "Trade" + "Read" scopes
# 4. Paste it here
# NOTE: If this is not set, the agent runs in paper-only mode (decisions still
#       logged to Supabase, no actual Deriv calls made).
DERIV_API_TOKEN=                            # leave blank for paper-only mode

# ── Vercel Cron ───────────────────────────────────────────────────────────────
# Set this to any random secret string. Vercel sends it automatically.
# Generate one: openssl rand -hex 32
CRON_SECRET=your_random_secret_here

# ── App URL (used by cron to call itself) ─────────────────────────────────────
# Set to your Vercel deployment URL in production.
# For local dev, leave as-is.
NEXT_PUBLIC_APP_URL=http://localhost:3000
